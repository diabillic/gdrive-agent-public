# Reference for every setting. In production these come from GitHub repo variables and secrets
# and are rendered to the container's environment on deploy; use this file for local runs.

# --- Required ---
# Your own Google OAuth client (type Desktop app) and the refresh token from deploy/google-auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Apprise URLs or Discord webhook URLs for the daily report, comma separated
NOTIFY_URLS=

# --- Asking to empty the trash ---
# A Discord webhook in a channel the assistant reads, and the assistant's Discord user ID. Both or neither.
ASSISTANT_URL=
ASSISTANT_USER_ID=
# Over this share of the storage limit (percent), the report asks to empty the trash
USAGE_PERCENT=75

# --- Agent bus (MCP for the assistant) ---
# Bearer token; empty turns the bus off
AGENT_BUS_TOKEN=
AGENT_BUS_PORT=8765
# code: the agent sends a one-time code to APPROVAL_NOTIFY_URLS. client: the assistant asks (Allow / Deny)
APPROVAL_MODE=code
# Where actions are announced (client) or codes are sent (code). Empty: drive_empty_trash always refuses
APPROVAL_NOTIFY_URLS=

# --- Optional ---
# Hour of the daily report, in the container's time zone
REPORT_HOUR=8
# How many of the largest files the report lists. 0 leaves the list out
TOP_FILES=10
# Where state is kept
STATE_DIR=/var/lib/gdrive-agent
